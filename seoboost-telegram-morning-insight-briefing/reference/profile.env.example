# Per-profile config. Save as ~/.claude/telegram-briefing/profiles/<profile-id>/profile.env
# Only CHAT_ID is required; BOT_TOKEN falls back to ~/.claude/channels/telegram/.env if unset.

CHAT_ID=123456789
# Optional: a client-specific bot instead of the shared one
# BOT_TOKEN=123456789:AA...
# Optional: extra read-only tools (default: WebSearch WebFetch). Never add Bash here.
# ALLOWED_TOOLS="WebSearch WebFetch"
